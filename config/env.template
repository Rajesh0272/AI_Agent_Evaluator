# ==============================================================================
# AI Agent Evaluator - Environment Configuration Template
# Copy this file to .env and configure as needed.
# DO NOT COMMIT YOUR REAL .env FILE WITH SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application Environment
EVALUATOR_ENV=development
EVALUATOR_LOG_LEVEL=INFO

# Evaluator Engine Mode: "rule", "llm", or "hybrid" (default: "rule")
EVALUATOR_ENGINE_MODE=rule

# LLM Provider Configuration (Optional - for LLM / Hybrid engine modes)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Enterprise Search / Vector Store Configuration (Optional extension credentials)
OPENSEARCH_HOST=
OPENSEARCH_PORT=9200
OPENSEARCH_APP_ID=
OPENSEARCH_SECRET_ID=
OPENSEARCH_INDEX=

# General API / Integration Credentials (Optional)
EXTERNAL_API_KEY=
APP_ID=
SECRET_ID=
